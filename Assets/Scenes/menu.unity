--- !u!114 &636067090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 636067087}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62726002a5b64511b971dd167174a731, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  loreTexts:
  - text: "\u201C And this is how all BEGAAN\u2026"
    fontSize: 30
    SpeakerAnimator: {fileID: 0}
  - text: '[Grandpa Gotchi]



      ...Long ago, much closer to the Genesis Block,
      the Nine Aadepts sacrificed themselves to activate the Great Portal, giving
      life to the Gotchiverse...

'
    fontSize: 27
    SpeakerAnimator: {fileID: 532729889}
  - text: "[Lil Gotchis]\r\n\r\n...Grandpa, is that why we have to protect the Great
      Portal?\r"
    fontSize: 30
    SpeakerAnimator: {fileID: 1450669425}
  - text: "[Grandpa Gotchi]\r\n\nExactly, my little Gotchis\u2026 by protecting the
      Great Portal, we may yet explore more of the Gotchiverse!\n\r\n...The ancient
      prophecy speaks of countless mysteries outside the safety of our Citadel. \n\r\n...But
      so far, no Aavegotchi has dared to explore the Grid that lies beyond...\r"
    fontSize: 17
    SpeakerAnimator: {fileID: 532729889}
  - text: "[Lil Gotchis]\r\n\n...Why hasn\u2019t anyone explored it, Grandpa?\r"
    fontSize: 30
    SpeakerAnimator: {fileID: 1450669425}
  - text: "[Grandpa Gotchi]\n\r\nThe scriptures warn of enormous Lickquidators, who
      seek to consume the power of our Great Portal. \r\nIf those robots find us
      exploring in their backyard, life in the Gotchiverse will be in grave danger...\r"
    fontSize: 24
    SpeakerAnimator: {fileID: 532729889}
  - text: "[Lil Gotchis]\n\r\n...But Grandpa, the prophecy says the Lickquidators
      will come to attack us and destroy the Great Portal anyway... So why wait?
      Let\u2019s go get them once and for all!\r"
    fontSize: 27
    SpeakerAnimator: {fileID: 1450669425}
  - text: "[Grandpa Gotchi]\n\r\nOh, my dear little Gotchis\u2026 I love your rektless
      energy, but we\u2019ve all vowed to stay within the Citadel to maintain the
      balance of the Gotchiverse\u2019s Spirit Force...\r"
    fontSize: 27
    SpeakerAnimator: {fileID: 532729889}
  loreText: {fileID: 1223200131}
  fadeColor: {r: 0.15686275, g: 0.16862746, b: 0.25882354, a: 1}
